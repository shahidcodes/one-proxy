{
  "name": "@one-proxy/proxy",
  "root": "packages/proxy",
  "sourceRoot": "packages/proxy/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx watch src/index.ts", "cwd": "packages/proxy" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc", "cwd": "packages/proxy" },
      "dependsOn": ["@one-proxy/shared:build"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "node dist/index.js", "cwd": "packages/proxy" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "cwd": "packages/proxy" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/proxy" }
    }
  }
}
